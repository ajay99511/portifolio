# ==============================================================================
# Environment Configuration Example
# Copy this file to .env.local and populate the values as needed.
# ==============================================================================

# Base URL for metadataBase, canonical URLs, and OpenGraph images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Web3Forms Access Key for contact form submissions
# If not provided, the contact form uses the default project key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Vercel Web Analytics & Speed Insights are enabled via @vercel/analytics
# and @vercel/speed-insights in production automatically when deployed on Vercel.
